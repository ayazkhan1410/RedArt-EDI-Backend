# Copy to .env and fill secrets. Do not commit real passwords.

# SFTP test seed (sftpcloud / MFT) — used by seed_demo_data
SFTP_SEED_NAME=SEED-SFTP-CLOUD
SFTP_SEED_HOST=eu-central-1.sftpcloud.io
SFTP_SEED_PORT=22
SFTP_SEED_USERNAME=
SFTP_SEED_PASSWORD=
SFTP_SEED_SEND_PATH=/send
SFTP_SEED_RECV_PATH=/recv

# MinIO / S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=edi-files
# Host / local Django:
AWS_S3_ENDPOINT_URL=http://127.0.0.1:7004
# Inside Docker Compose backend uses http://minio:9000 via docker.py
