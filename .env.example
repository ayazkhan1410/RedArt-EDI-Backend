# Copy to .env and adjust. Never commit .env.

DJANGO_SETTINGS_MODULE=redartdigital.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=false
CORS_ALLOW_ALL_ORIGINS=true

# ========
# Postgres (used by Docker Compose)
# ========
POSTGRES_DB=edi
POSTGRES_USER=edi
POSTGRES_PASSWORD=edi
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# ========
# Redis / Celery
# ========
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_LOG_LEVEL=INFO
CELERY_CONCURRENCY=2

# ========
# Ports
# ========
WEB_PORT=8000
REDIS_PORT=6379
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Production example (DJANGO_SETTINGS_MODULE=redartdigital.settings.production):
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=edi.example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# CORS_ALLOW_ALL_ORIGINS=false
# CORS_ALLOWED_ORIGINS=https://redartdigital.com
