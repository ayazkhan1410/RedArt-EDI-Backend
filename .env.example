# =============================================================================
# Dev Required Variables
# =============================================================================
# Copy to .env and adjust for local Docker / development.
# Never commit real production secrets to git.

# Django core
DJANGO_SETTINGS_MODULE=redartdigital.settings.local
DJANGO_SECRET_KEY=django-insecure-local-dev-only-replace-before-deploy
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=false

# CORS / CSRF (local UI or Swagger)
CORS_ALLOW_ALL_ORIGINS=true
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:7000,http://localhost:7000

# Admin bootstrap (Docker entrypoint creates superuser on first start)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@redartdigital.com
DJANGO_SUPERUSER_PASSWORD=change-me-local-admin

# Postgres (Docker Compose — backend uses POSTGRES_HOST=db)
POSTGRES_DB=edi
POSTGRES_USER=edi
POSTGRES_PASSWORD=edi
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_LOG_LEVEL=INFO
CELERY_CONCURRENCY=2

# MinIO / S3 (local Docker defaults)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=edi-files
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# EDI API service account (optional — entrypoint can create from these)
EDI_API_SERVICE_USERNAME=redart_api
EDI_API_SERVICE_EMAIL=redart-api@redartdigital.com

# Attachment workflow (dev)
ATTACHMENT_ADAPTER_DEFAULT=HCPF_PORTAL
ATTACHMENT_MFT_ENABLED=false
ATTACHMENT_PRODUCTION_MODE=false
ATTACHMENT_MFT_ENVIRONMENT=TEST

# SFTP host-key check (disable for local test SFTP without fingerprints)
EDI_SFTP_REQUIRE_HOST_FINGERPRINT=false

# Upload limits
CLAIM_DOCUMENT_MAX_BYTES=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=12582912
FILE_UPLOAD_MAX_MEMORY_SIZE=12582912
EDI_MAX_SFTP_DOWNLOAD_BYTES=5000000

# JWT (optional overrides)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
JWT_BLACKLIST_AFTER_ROTATION=true

# API auth — keep true; never set false outside isolated demos
API_REQUIRE_AUTH=true

# Docker host ports (Compose)
WEB_PORT=7000
POSTGRES_HOST_PORT=7001
REDIS_HOST_PORT=7002
FLOWER_HOST_PORT=7003
USE_GUNICORN=false
RUN_MIGRATE_ON_START=true
AUTO_RELOAD=true
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# =============================================================================
# Prod Required Variables
# =============================================================================
# Set these on Render / production host (use redartdigital.settings.production).

# DJANGO_SETTINGS_MODULE=redartdigital.settings.production
# DJANGO_SECRET_KEY=                          # REQUIRED — long random string
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=                       # REQUIRED — your API hostname(s)
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=                      # https://your-api-host
# CORS_ALLOWED_ORIGINS=                       # RedArt backend origin(s)

# POSTGRES_HOST=                              # REQUIRED
# POSTGRES_DB=edi
# POSTGRES_USER=edi
# POSTGRES_PASSWORD=                          # REQUIRED — strong password
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require

# CELERY_BROKER_URL=                          # REQUIRED — redis URL
# CELERY_RESULT_BACKEND=                      # REQUIRED — redis URL

# AWS_ACCESS_KEY_ID=                          # REQUIRED — S3/MinIO credentials
# AWS_SECRET_ACCESS_KEY=                      # REQUIRED
# AWS_STORAGE_BUCKET_NAME=edi-files
# AWS_S3_ENDPOINT_URL=                        # S3 or MinIO endpoint
# AWS_S3_REGION_NAME=us-east-1

# EDI_DEFAULT_BILLING_TAX_ID=                 # Provider TIN for 837P if not on profile
# EDI_PUBLIC_BASE_URL=                        # Public API URL for RedArt / docs
# EDI_SFTP_REQUIRE_HOST_FINGERPRINT=true      # REQUIRED in production

# ATTACHMENT_PRODUCTION_MODE=true             # When HCPF channel confirmed
# ATTACHMENT_PRODUCTION_DEFAULT_CHANNEL=HCPF_APPROVED_CHANNEL
# ATTACHMENT_MFT_ENABLED=true
# ATTACHMENT_MFT_ENVIRONMENT=PRODUCTION
# ATTACHMENT_MFT_REMOTE_PATH_TEMPLATE={claim_number}/{document_type}/{filename}

# EDI_API_SERVICE_USERNAME=redart_api         # Service JWT user (create via manage.py)
# EDI_API_SERVICE_EMAIL=

# API_USER_THROTTLE=120/min
# API_ANON_THROTTLE=30/min

