# Copy to .env and adjust. Never commit .env.

DJANGO_SETTINGS_MODULE=redartdigital.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=false
CORS_ALLOW_ALL_ORIGINS=true
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:7000,http://localhost:7000

# ========
# Admin superuser (created in Docker Postgres on backend start)
# ========
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@redartdigital.com
DJANGO_SUPERUSER_PASSWORD=admin123

# ========
# Postgres (used by Docker Compose)
# ========
POSTGRES_DB=edi
POSTGRES_USER=edi
POSTGRES_PASSWORD=edi
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# ========
# Redis / Celery
# ========
CELERY_BROKER_URL=redis://localhost:7002/0
CELERY_RESULT_BACKEND=redis://localhost:7002/1
CELERY_LOG_LEVEL=INFO
CELERY_CONCURRENCY=2

# ========
# Host ports + local server mode
# 7000 backend | 7001 postgres | 7002 redis
# USE_GUNICORN=false → Django runserver (admin CSS works)
# ========
WEB_PORT=7000
POSTGRES_HOST_PORT=7001
REDIS_HOST_PORT=7002
FLOWER_HOST_PORT=7003
USE_GUNICORN=false
RUN_MIGRATE_ON_START=true
AUTO_RELOAD=true
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Production example:
# USE_GUNICORN=true
# AUTO_RELOAD=false
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=edi.example.com
